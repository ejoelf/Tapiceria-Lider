{
  "name": "tapiceria-lider-backend",
  "version": "2.0.0",
  "description": "API backend de Tapicer\u00eda L\u00edder",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:status": "sequelize-cli db:migrate:status",
    "db:seed": "node scripts/seed.mjs",
    "user:create": "node scripts/create-user.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "keywords": [
    "tapiceria",
    "backend",
    "express",
    "postgresql",
    "sequelize"
  ],
  "author": "Joel / NexoDigital",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.3.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "sequelize": "^6.37.8",
    "@supabase/supabase-js": "2.116.0",
    "cookie-parser": "1.4.7",
    "express-rate-limit": "8.7.0",
    "zod": "4.3.6",
    "sharp": "0.35.4",
    "decimal.js": "10.6.0",
    "file-type": "21.3.4"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3",
    "supertest": "7.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
