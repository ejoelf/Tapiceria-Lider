NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://lider:REEMPLAZAR@localhost:5432/tapiceria_lider
DB_SSL=false
SESSION_SECRET=GENERAR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
AUTH_PROVIDER=local
STORAGE_PROVIDER=local
STORAGE_ROOT=uploads
FRONTEND_WEB_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:5174
API_URL=http://localhost:4000
COOKIE_SAME_SITE=lax
# Producción: supabase en ambos proveedores. Nunca enviar estas claves al navegador.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=lider-private
# Integraciones opcionales. Sin configurar, los mensajes quedan en borrador.
RESEND_API_KEY=
EMAIL_FROM=
AI_API_KEY=
AI_API_URL=
AI_MODEL=
